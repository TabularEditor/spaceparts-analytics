		lineageTag: 762198d6-0454-4be8-bd34-93a179964871
		summarizeBy: none
		sourceColumn: Velocity Tolerance (Meters / Second)

		annotation SummarizationSetBy = Automatic

	/// Unit weight in tonnes.
	column 'Weight (Tonnes)'
		dataType: double
		formatString: #,##0.00
