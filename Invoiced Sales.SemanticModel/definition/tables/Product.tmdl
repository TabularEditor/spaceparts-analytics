/// Products sold, one row per product, with brand and physical attributes.
table Product
	lineageTag: 4963b255-25ef-4ad6-8fc0-3991443146a0

	/// Count of distinct products in the current filter context.
	measure '# Products' =
			
			COUNTROWS (
			    VALUES ( Product[Product Name] )
			)
		formatString: #,##0
		displayFolder: Measures
		lineageTag: 1fb6f2e9-ed3c-4c97-8fdc-95d1d037a0de

	column 'Sub Brand Name'
		dataType: string
		isHidden
		isAvailableInMdx: false
		displayFolder: 6. Keys
		lineageTag: 46b52e9b-f065-4a4b-a860-cbd239180893
		summarizeBy: none
		sourceColumn: Sub Brand Name

		annotation SummarizationSetBy = Automatic

	/// The shipping classification determining logistics handling.
	column 'Ship Class for Part'
		dataType: string
		displayFolder: 2. Product Attributes
		lineageTag: 8b05870e-ec7e-4bee-b9cc-3998508fd4c9
		summarizeBy: none
		sourceColumn: Ship Class for Part

		annotation SummarizationSetBy = Automatic

	/// Name of the product.
	column 'Product Name'
		dataType: string
		displayFolder: 1. Product Hierarchy
		lineageTag: 31fc2387-5a7f-4655-a5ea-0bc51c07852a
		summarizeBy: none
		sourceColumn: Product Name

		annotation SummarizationSetBy = Automatic

	/// The quality grading for part fitting tolerance.
	column 'Part Fit Grading'
		dataType: string
		displayFolder: 2. Product Attributes
		lineageTag: 5832f019-fb01-4e09-ab32-ca411cb31e53
		summarizeBy: none
		sourceColumn: Part Fit Grading

		annotation SummarizationSetBy = Automatic

	column 'Product Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		displayFolder: 6. Keys
		lineageTag: 0af3eedf-9023-45c6-9b52-df7c4c69ee12
		summarizeBy: none
		sourceColumn: Product Key

		annotation SummarizationSetBy = Automatic

	/// Product family within a type.
	column Subtype
		dataType: string
		displayFolder: 1. Product Hierarchy
		lineageTag: 15258ae0-314c-4258-b6a9-c5f4b1f7c0df
		summarizeBy: none
		sourceColumn: Subtype

		annotation SummarizationSetBy = Automatic

	/// Top product grouping: Structural, Propulsion, Hull, or Instruments.
	column Type
		dataType: string
		displayFolder: 1. Product Hierarchy
		lineageTag: 85080b98-1526-4199-8045-b27395dcead7
		summarizeBy: none
		sourceColumn: Type

		annotation SummarizationSetBy = Automatic

	/// Mark, the version of the product design.
	column MK
		dataType: string
		displayFolder: 2. Product Attributes
		lineageTag: 434ef8cd-463c-423c-98d0-133def571872
		summarizeBy: none
		sourceColumn: MK

		annotation SummarizationSetBy = Automatic

	/// Product color.
	column Color
		dataType: string
		displayFolder: 2. Product Attributes
		lineageTag: d09831f4-99c0-40cd-b760-3fde292b3c21
		summarizeBy: none
		sourceColumn: Color

		annotation SummarizationSetBy = Automatic

	/// The manufacturing production series identifier.
	column 'Production Series'
		dataType: string
		displayFolder: 2. Product Attributes
